# Өгөгдлийн сан
DATABASE_URL=postgresql://proliance:proliance@localhost:5432/proliance_lms_a
# Нэвтрэлтийн түлхүүр (32+ тэмдэгт санамсаргүй мөр)
AUTH_SECRET=change-me-to-a-long-random-string
# Системийн бүтэн хаяг (имэйл доторх холбоосонд ашиглана)
APP_URL=https://proliance.mn/surgalt
# Байршуулсан видео, PDF хадгалах хавтас
UPLOAD_DIR=./uploads
# Анхны админ (seed)
ADMIN_EMAIL=admin@proliance.mn
ADMIN_PASSWORD=change-me-strong-password

# Имэйл (SMTP). Хоосон бол имэйлийг серверийн лог руу бичнэ.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Proliance сургалт <surgalt@proliance.mn>"

# SMS. Үйлчилгээ үзүүлэгчийн HTTP API. Хоосон бол лог руу бичнэ.
# Хүсэлт: POST SMS_API_URL, JSON {"to": "...", "text": "..."}, толгой: Authorization: Bearer SMS_API_KEY
SMS_API_URL=
SMS_API_KEY=

# Хугацаа дөхсөн сануулгын cron дуудлагын нууц
CRON_SECRET=change-me

# Дэд хаяг (жишээ: /surgalt). Root дээр бол хоосон.
NEXT_PUBLIC_BASE_PATH=

# Цагийн бүс (хуваарийн цаг, огноо харуулахад)
APP_TZ=Asia/Ulaanbaatar
